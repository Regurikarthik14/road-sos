# =========================================================
# Server Environment Variables
# =========================================================

# --- MongoDB ---
# Get a free cluster at https://cloud.mongodb.com (M0 tier, no credit card)
# Create a database user, then get your connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/raksha?retryWrites=true&w=majority

# --- JWT ---
# Use a strong random string (run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-random-jwt-secret-here

# --- Twilio (for SMS OTP) ---
# Sign up at https://twilio.com (pay-as-you-go, ~$0.0079/SMS)
# Get Account SID and Auth Token from the Twilio Console
# Buy or get a trial phone number that can send SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# --- Resend (for password reset & email OTP fallback emails) ---
# Sign up at https://resend.com (free tier: 100 emails/day, no credit card)
# Verify a domain (e.g., your-domain.com) to send from
RESEND_API_KEY=re_your-resend-api-key

# --- Frontend URL (for CORS & password reset links) ---
FRONTEND_URL=http://localhost:5173

# --- Server Port ---
PORT=3001

# --- Admin ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then call: curl -H "Authorization: Bearer <secret>" https://your-app.onrender.com/api/admin/users
ADMIN_SECRET=your-random-admin-secret-here
